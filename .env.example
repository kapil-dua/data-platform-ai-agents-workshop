# Global configurations
ENV=dev

REFRESH_INTERVAL=60

# ============================================
# Model Provider Configuration
# ============================================
# Model provider options: "ollama", "groq", "databricks"
MODEL_PROVIDER = "databricks"

OLLAMA_MODEL_ID="llama3.2:1b-instruct-q4_K_M"

GROQ_MODEL_ID="openai/gpt-oss-20b"
GROQ_API_KEY=""

DATABRICKS_AI_GATEWAY="https://dbc-92d9daf8-01c9.cloud.databricks.com/ai-gateway/mlflow/v1"
DATABRICKS_TOKEN=""
DATABRICKS_MODEL_ID="system.ai.meta-llama-3-1-8b-instruct"


# ============================================
# Data Platform Configuration
# ============================================
DATABRICKS_WORKSPACE_HOST="https://dbc-<>.cloud.databricks.com"
DATABRICKS_TOKEN=""

# ============================================
# Atlassian Jira configurations
# ============================================
# Enable/disable Jira integration
JIRA_ENABLED=true

ATLASSIAN_MCP_URL="https://mcp.atlassian.com/v2/mcp"
ATLASSIAN_CLOUD_ID="mycompany.atlassian.net"
ATLASSIAN_EMAIL=""
ATLASSIAN_API_TOKEN=""
ATLASSIAN_PROJECT_KEY=""
ATLASSIAN_ISSUE_TYPE=""

# ============================================
# Langfuse Observability Configuration
# ============================================
# Enable/disable Langfuse tracing for all agents
LANGFUSE_ENABLED=false

# Langfuse host (use https://cloud.langfuse.com for cloud or your self-hosted URL)
LANGFUSE_HOST=https://cloud.langfuse.com

# Get these from https://cloud.langfuse.com/settings
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

# Batch settings for trace submission (optional)
LANGFUSE_BATCH_SIZE=100
LANGFUSE_FLUSH_INTERVAL=10